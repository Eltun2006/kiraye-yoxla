# Copy to .env and fill in. Never commit .env.

# Which LLM to use: anthropic | gemini
LLM_PROVIDER=gemini

# --- Claude (paid, pay-as-you-go) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- Google Gemini (free tier available: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL from docker-compose (host port 55432). Start it with: docker compose up -d db
# Use 127.0.0.1, not "localhost": on Windows localhost may resolve to IPv6 ::1 and hit another server.
DATABASE_URL=postgresql+psycopg2://kiraye:kiraye@127.0.0.1:55432/kiraye
# No Docker? Quick local fallback:
# DATABASE_URL=sqlite:///./kiraye.db

MAX_UPLOAD_MB=5
MAX_CHARS=40000
MAX_CLAUSES=100

# Abuse protection — each analysis is one LLM call
RATE_LIMIT_PER_HOUR=5
DAILY_ANALYSIS_LIMIT=15
# true only when running behind a reverse proxy (e.g. Hugging Face Spaces), never when exposed directly
TRUST_PROXY=false
# Analyses (contracts may contain personal data) are deleted after this many days
RETENTION_DAYS=30
